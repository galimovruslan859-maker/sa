# ---------------------------------------------------------------------------
# RESELL backend — переменные окружения
# Скопируйте файл в backend/.env и при необходимости измените значения.
# ---------------------------------------------------------------------------

# Порт HTTP-сервера
PORT=4000

# Режим работы с PostgreSQL:
#   pglite — встроенный PostgreSQL (WebAssembly), данные в папке .pgdata
#   pg     — внешний сервер PostgreSQL (нужен DATABASE_URL)
DATABASE_ENGINE=pglite

# Строка подключения к PostgreSQL (обязательна для DATABASE_ENGINE=pg,
# а также используется Prisma Client в режиме pg)
DATABASE_URL=postgresql://resell:resell@localhost:5432/resell?schema=public

# Каталог данных встроенного PostgreSQL
PGLITE_DATA_DIR=./.pgdata

# Секрет для подписи JWT-токенов (в продакшене — длинная случайная строка)
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_EXPIRES_IN=7d

# Адрес фронтенда для CORS (можно перечислить несколько через запятую)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Куда сохранять загруженные фотографии товаров
UPLOAD_DIR=./uploads

# Каталог production-сборки фронтенда (frontend/dist).
# Если сборка существует, API раздаёт магазин на том же порту:
#   GET /  ->  страница приложения, а /api/* остаётся за REST API.
# Для разработки с Vite (порт 5173) переменную можно не задавать.
FRONTEND_DIST=../frontend/dist

# Демонстрационный режим: выводить SQL-запросы в консоль
DEBUG_SQL=false
