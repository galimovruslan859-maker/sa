# ---------------------------------------------------------------------------
# RESELL — переменные окружения (корневой пример)
#
# Основной файл настроек — backend/.env (скопируйте backend/.env.example).
# Здесь же собраны все переменные проекта, включая фронтенд и Docker.
# ---------------------------------------------------------------------------

# =============================== BACKEND ===================================

# Порт HTTP-сервера API
PORT=4000

# Режим работы с PostgreSQL:
#   pglite — встроенный PostgreSQL (WebAssembly), данные в backend/.pgdata
#   pg     — внешний сервер PostgreSQL (нужен DATABASE_URL)
DATABASE_ENGINE=pglite

# Строка подключения к PostgreSQL
DATABASE_URL=postgresql://resell:resell@localhost:5432/resell?schema=public

# Каталог данных встроенного PostgreSQL (для DATABASE_ENGINE=pglite)
PGLITE_DATA_DIR=./.pgdata

# Секрет для подписи JWT-токенов (в продакшене — длинная случайная строка)
JWT_SECRET=change-me-in-production-please-use-long-random-string
JWT_EXPIRES_IN=7d

# Адрес фронтенда для CORS (несколько значений через запятую, * — разрешить все)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Куда сохранять загруженные фотографии товаров
UPLOAD_DIR=./uploads

# Выводить SQL-запросы в консоль (демонстрационный режим)
DEBUG_SQL=false

# =============================== FRONTEND ==================================

# Адрес backend для проксирования в dev-сервере Vite
# (браузер всегда ходит по относительному пути /api — localhost в коде клиента нет)
VITE_BACKEND_URL=http://localhost:4000

# Порт dev-сервера и порт предпросмотра production-сборки
PORT=5173
PREVIEW_PORT=4173

# ================================ DOCKER ===================================

POSTGRES_USER=resell
POSTGRES_PASSWORD=resell
POSTGRES_DB=resell
POSTGRES_PORT=5432
